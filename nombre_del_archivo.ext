```javascript
// Importaciones necesarias
import axios from 'axios';
import { createAsyncThunk, createSlice } from '@reduxjs/toolkit';

// Definición de la URL base para las llamadas a la API
const API_BASE_URL = 'https://api.trello.com/1';

// Creación de un thunk para obtener datos de Trello
export const fetchTrelloData = createAsyncThunk(
  'trello/fetchData',
  async (boardId, { rejectWithValue }) => {
    try {
      const response = await axios.get(`${API_BASE_URL}/boards/${boardId}/cards`, {
        params: {
          key: process.env.REACT_APP_TRELLO_API_KEY,
          token: process.env.REACT_APP_TRELLO_API_TOKEN,
        },
      });
      return response.data;
    } catch (error) {
      return rejectWithValue(error.response ? error.response.data : { message: error.message });
    }
  }
);

// Definición del slice de Redux para el estado de Trello
const trelloSlice = createSlice({
  name: 'trello',
  initialState: {
    data: [],
    status: 'idle',
    error: null,
  },
  reducers: {},
  extraReducers: (builder) => {
    builder
      .addCase(fetchTrelloData.pending, (state) => {
        state.status = 'loading';
      })
      .addCase(fetchTrelloData.fulfilled, (state, action) => {
        state.status = 'succeeded';
        state.data = action.payload;
      })
      .addCase(fetchTrelloData.rejected, (state, action) => {
        state.status = 'failed';
        state.error = action.payload;
      });
  },
});

// Exportación de los reducers y thunks
export default trelloSlice.reducer;
```